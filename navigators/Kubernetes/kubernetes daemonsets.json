              "resolution": 60000,
              "template": "CONTAINER_RESTARTS_TOTAL = data('k8s.container.restarts', filter=filter('k8s.daemonset.name', '*'){{#filter}} and {{{filter}}}{{/filter}}, rollup='min').min(over=Args.get('ui.dashboard_window', '15m')).min(by=['k8s.pod.name', 'k8s.pod.uid', 'k8s.cluster.name', 'k8s.daemonset.name', 'k8s.daemonset.uid', 'k8s.namespace.name']).publish(label='A', enable=False)\nCONTAINER_MAX = data('k8s.container.restarts', filter=filter('k8s.daemonset.name', '*'){{#filter}} and {{{filter}}}{{/filter}}, rollup='max').max(over=Args.get('ui.dashboard_window', '15m')).max(by=['k8s.pod.name', 'k8s.pod.uid', 'k8s.cluster.name', 'k8s.daemonset.name', 'k8s.daemonset.uid', 'k8s.namespace.name']).publish(label='B', enable=False)\nDAEMONSET_CONTAINER_RESTARTS_TOTAL = (CONTAINER_MAX-CONTAINER_RESTARTS_TOTAL).sum(by=['k8s.daemonset.name', 'k8s.daemonset.uid', 'k8s.cluster.name', 'k8s.namespace.name'])",
