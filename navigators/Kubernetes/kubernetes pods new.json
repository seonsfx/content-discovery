            "description": "This metric shows the cpu usage of the node aggregated over all the containers of pod (%). Under 20% green, over 80% red.",
            "displayName": "CPU usage (%)",
            "id": "k8s_pods_cpu_usage",
            "job": {
              "filters": [
                {
                  "not": false,
                  "property": "_exists_",
                  "propertyValue": "k8s.node.name",
                  "type": "property"
                },
                {
                  "not": false,
                  "property": "_exists_",
                  "propertyValue": "k8s.cluster.name",
                  "type": "property"
                },
                {
