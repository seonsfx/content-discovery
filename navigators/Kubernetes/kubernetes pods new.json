            "description": "This metric shows the phases of pods.",
            "displayName": "Pod phase",
            "id": "pod_phases",
            "job": {
              "filters": [],
              "resolution": 300000,
              "template": "PENDING = data('k8s.pod.phase', filter=(not filter('k8s.workload.kind', 'Job', 'CronJob')){{#filter}} and {{{filter}}}{{/filter}}).sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid']).equals(1).promote(by='phase', allow_missing={'phase':'Pending'})\nRUNNING = data('k8s.pod.phase', filter=(not filter('k8s.workload.kind', 'Job', 'CronJob')){{#filter}} and {{{filter}}}{{/filter}}).sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid']).equals(2).promote(by='phase', allow_missing={'phase':'Running'})\nSUCCEEDED = data('k8s.pod.phase', filter=(not filter('k8s.workload.kind', 'Job', 'CronJob')){{#filter}} and {{{filter}}}{{/filter}}).sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid']).equals(3).promote(by='phase', allow_missing={'phase':'Succeeded'})\nFAIL = data('k8s.pod.phase',filter=(not filter('k8s.workload.kind', 'Job', 'CronJob')){{#filter}} and {{{filter}}}{{/filter}}).sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid']).equals(4).promote(by='phase', allow_missing={'phase':'Failed'})\nUNKNOWN = data('k8s.pod.phase',filter=(not filter('k8s.workload.kind', 'Job', 'CronJob')){{#filter}} and {{{filter}}}{{/filter}}).sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid']).equals(5).promote(by='phase', allow_missing={'phase':'Unknown'})\nNA = data('k8s.pod.phase',filter=(not filter('k8s.workload.kind', 'Job', 'CronJob')){{#filter}} and {{{filter}}}{{/filter}}).sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid']).map(lambda x: 6 if x is None else x).equals(6).promote(by='phase', allow_missing={'phase':'n/a'})\nPENDING_JOB = data('k8s.pod.phase', filter=(filter('k8s.workload.kind', 'Job', 'CronJob')){{#filter}} and {{{filter}}}{{/filter}},extrapolation='last_value', maxExtrapolations=-1).sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid']).equals(1).promote(by='phase', allow_missing={'phase':'Pending'})\nRUNNING_JOB = data('k8s.pod.phase', filter=(filter('k8s.workload.kind', 'Job', 'CronJob')){{#filter}} and {{{filter}}}{{/filter}},extrapolation='last_value', maxExtrapolations=-1).sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid']).equals(2).promote(by='phase', allow_missing={'phase':'Running'})\nSUCCEED_JOB = data('k8s.pod.phase', filter=(filter('k8s.workload.kind', 'Job', 'CronJob')){{#filter}} and {{{filter}}}{{/filter}},extrapolation='last_value', maxExtrapolations=-1).sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid']).equals(3).promote(by='phase', allow_missing={'phase':'Succeeded'})\nFAIL_JOB = data('k8s.pod.phase',filter=(filter('k8s.workload.kind', 'Job', 'CronJob')){{#filter}} and {{{filter}}}{{/filter}},extrapolation='last_value', maxExtrapolations=-1).sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid']).equals(4).promote(by='phase', allow_missing={'phase':'Failed'})\nUNKNOWN_JOB = data('k8s.pod.phase',filter=(filter('k8s.workload.kind', 'Job', 'CronJob')){{#filter}} and {{{filter}}}{{/filter}},extrapolation='last_value', maxExtrapolations=-1).sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid']).equals(5).promote(by='phase', allow_missing={'phase':'Unknown'})\nNA_JOB = data('k8s.pod.phase',filter=(filter('k8s.workload.kind', 'Job', 'CronJob')){{#filter}} and {{{filter}}}{{/filter}},extrapolation='last_value', maxExtrapolations=-1).sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid']).map(lambda x: 6 if x is None else x).equals(6).promote(by='phase', allow_missing={'phase':'n/a'})\nPOD_PHASE = union(PENDING,RUNNING,SUCCEEDED,FAIL,UNKNOWN,NA,PENDING_JOB,RUNNING_JOB,SUCCEED_JOB,FAIL_JOB,UNKNOWN_JOB,NA_JOB)",
              "varName": "POD_PHASE"
