              "resolution": 300000,
              "template": "OTEL_CPU_USAGE = data('container_cpu_utilization'{{#filter}}, filter={{{filter}}}{{/filter}}, rollup='rate').sum(by=['k8s.node.name', 'k8s.cluster.name', 'k8s.pod.name', 'k8s.pod.uid']).scale(0.01)\nOTEL_CPU_PROCESSORS = data('cpu.num_processors'{{#filter}}, filter={{{filter}}}{{/filter}}).sum(by=['k8s.node.name', 'k8s.cluster.name'])\nCPU_USAGE = (OTEL_CPU_USAGE*100)/OTEL_CPU_PROCESSORS\nCPU_TIME = data('cotainer.cpu.time'{{#filter}}, filter={{{filter}}}{{/filter}}, rollup='rate').sum(by=['k8s.node.name', 'k8s.cluster.name', 'k8s.pod.name', 'k8s.pod.uid'])\nSYSTEM_CPU_TIME = data('system.cpu.time', filter('state', 'idle'){{#filter}} and {{{filter}}}{{/filter}}).count(by=['k8s.node.name', 'k8s.cluster.name'])\nCPU_PRE_USAGE = (CPU_TIME/SYSTEM_CPU_TIME)*100\nCPU_UTILIZATION = union(CPU_USAGE, CPU_PRE_USAGE)",
              "varName": "CPU_UTILIZATION"
            },
