                  "property": "_exists_",
                  "propertyValue": "k8s.pod.uid",
                  "type": "property"
                },
                {
                  "not": false,
                  "property": "_exists_",
                  "propertyValue": "k8s.pod.name",
                  "type": "property"
                }
              ],
              "resolution": 60000,
              "template": "POD_CPU = data(\"container_cpu_utilization\"{{#filter}}, filter={{{filter}}}{{/filter}}, rollup=\"rate\").sum(by=[\"k8s.pod.name\"])\nNEW_NUM_CORES = data(\"cpu.num_processors\"{{#filter}}, filter={{{filter}}}{{/filter}}, rollup=\"average\").sum()\nPOD_CPU_NEW = (POD_CPU/NEW_NUM_CORES)\nOLD_NUM_CORES = data(\"machine_cpu_cores\"{{#filter}}, filter={{{filter}}}{{/filter}}, rollup=\"average\").sum()\nPOD_CPU_OLD = (POD_CPU/OLD_NUM_CORES)\nCPU_LIMIT_FARGATE = data(\"k8s.container.cpu_limit\", filter=filter(\"eks.amazonaws.com/fargate-profile\", \"*\") and filter(\"k8s.cluster.name\", \"*\") and filter(\"k8s.node.name\", \"*\"){{#filter}} and filter={{{filter}}}{{/filter}}).sum(by=[\"k8s.pod.name\"])\nCPU_UTILIZATION_FARGATE = data(\"container.cpu.utilization\", filter=filter(\"eks.amazonaws.com/fargate-profile\", \"*\") and filter(\"k8s.cluster.name\", \"*\") and filter(\"k8s.node.name\", \"*\"){{#filter}} and filter={{{filter}}}{{/filter}}).sum(by=[\"k8s.pod.name\"])\nCPU_USED_FARGATE = ((CPU_UTILIZATION_FARGATE*100)/CPU_LIMIT_FARGATE)\nPOD_CPU_USAGE = union(POD_CPU_NEW, POD_CPU_OLD, CPU_USED_FARGATE)",
              "varName": "POD_CPU_USAGE"
            },
            "metricSelectors": [
              "container_cpu_utilization",
              "cpu.num_processors",
              "machine_cpu_cores",
              "k8s.container.cpu_limit"
            ],
            "type": "metric",
            "valueFormat": "Percentage",
            "valueLabel": "CPU usage",
            "valueType": null
