              "resolution": 60000,
              "template": "ERR_TOTAL = data(\"k8s.pod.network.errors\"{{#filter}}, filter={{{filter}}}{{/filter}}, extrapolation=\"last_value\", maxExtrapolations=2).sum(by=[\"k8s.cluster.name\", \"k8s.node.name\", \"k8s.pod.name\", \"k8s.pod.uid\",\"k8s.namespace.name\"])",
