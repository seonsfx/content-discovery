              "template": "USAGE = data('container.memory.usage', filter('k8s.deployment.name', '*', match_missing=True) and filter('sf_tags', '*', match_missing=True){{#filter}} and {{{filter}}}{{/filter}}).sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid'])\nLIMIT = data('k8s.container.memory_limit', filter('k8s.deployment.name', '*', match_missing=True) and filter('sf_tags', '*', match_missing=True){{#filter}} and {{{filter}}}{{/filter}}).sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid']).above(0, inclusive=True)\nMEMORY_USAGE = (USAGE/LIMIT*100)",
