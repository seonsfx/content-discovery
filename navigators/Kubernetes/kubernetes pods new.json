              "resolution": 60000,
              "template": "\nKUBE_POD_PHASE = data(\"k8s.pod.phase\" {{#filter}}, filter={{{filter}}}{{/filter}}, extrapolation=\"last_value\", maxExtrapolations=2, rollup=\"latest\")\nKUBE_POD_PHASE.count(by=[\"k8s.cluster.name\", \"k8s.node.name\", \"k8s.pod.name\", \"k8s.pod.uid\", \"sf_service\"]).publish(\"Pod SFx Service\")\nKUBE_POD_PHASE.count(by=[\"k8s.cluster.name\", \"k8s.node.name\", \"k8s.pod.name\", \"k8s.pod.uid\", \"sf_environment\"]).publish(\"Pod SFx Environment\")",
              "varName": "KUBE_POD_PHASE"
