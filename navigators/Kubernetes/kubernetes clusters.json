              ]
            },
            "description": "This metric shows the total number of containers present in the cluster. Darker colors indicate higher relative values.",
            "displayName": "# Containers",
            "id": "kubernetes_clusters_containers",
            "job": {
              "filters": [],
              "resolution": 60000,
              "template": "CONTAINER_COUNT = data(\"container_cpu_utilization\"{{#filter}}, filter={{{filter}}}{{/filter}}, rollup=\"rate\").scale(0.01).mean(over=\"1m\").count(by=[\"k8s.cluster.name\"])",
              "varName": "CONTAINER_COUNT"
            },
            "metricSelectors": [
              "container_cpu_utilization"
            ],
            "type": "metric",
            "valueFormat": "Number",
            "valueLabel": "Containers",
            "valueType": null
          },
          {
            "coloring": {
              "limits": null,
              "maxValue": null,
              "method": "quantile",
              "minValue": 0,
              "range": [
                "#bfd3e6",
                "#9ebcda",
                "#8c96c6",
                "#8856a7",
                "#810f7c"
              ]
            },
            "description": "This metric shows the total number of nodes present in the cluster. Darker colors indicate higher relative values.",
            "displayName": "# Nodes",
            "id": "kubernetes_clusters_nodes",
            "job": {
              "filters": [],
              "resolution": 60000,
              "template": "NODES_PER_CLUSTER = data(\"k8s.node.condition_ready\"{{#filter}}, filter={{{filter}}}{{/filter}}).sum(by=[\"k8s.node.name\", \"k8s.cluster.name\"]).mean(over=\"1m\").count(by=[\"k8s.cluster.name\"])",
              "varName": "NODES_PER_CLUSTER"
            },
            "metricSelectors": [
              "k8s.node.condition_ready"
            ],
            "type": "metric",
            "valueFormat": "Number",
            "valueLabel": "Nodes",
            "valueType": null
          },
          {
            "coloring": {
              "limits": null,
              "maxValue": null,
              "method": "quantile",
              "minValue": 0,
              "range": [
                "#bfd3e6",
                "#9ebcda",
                "#8c96c6",
                "#8856a7",
                "#810f7c"
              ]
            },
            "description": "This metric shows the total number of namespaces present in the cluster. Darker colors indicate higher relative values.",
            "displayName": "# Namespace",
            "id": "kubernetes_clusters_namespace",
            "job": {
              "filters": [],
              "resolution": 60000,
              "template": "NAMESPACE = data(\"k8s.namespace.phase\"{{#filter}},filter={{{filter}}}{{/filter}}).count(by=[\"k8s.cluster.name\"])",
              "varName": "NAMESPACE"
            },
            "metricSelectors": [
              "k8s.namespace.phase"
            ],
            "type": "metric",
            "valueFormat": "Number",
            "valueLabel": "Namespace",
            "valueType": null
          },
          {
            "coloring": {
              "limits": null,
              "maxValue": null,
              "method": "quantile",
              "minValue": 0,
              "range": [
                "#bfd3e6",
                "#9ebcda",
                "#8c96c6",
                "#8856a7",
                "#810f7c"
              ]
            },
            "description": "This metric shows the cumulative count of network errors encountered while receiving and transmitting data. Darker colors indicate higher relative values.",
            "displayName": "# Network errors",
            "id": "kubernetes_clusters_network_errors",
            "job": {
              "filters": [],
              "resolution": 60000,
              "template": "NET_ERROR_PER_CLUSTER = data(\"k8s.pod.network.errors\"{{#filter}}, filter={{{filter}}}{{/filter}}, rollup=\"rate\").sum(by=[\"k8s.cluster.name\"])",
              "varName": "NET_ERROR_PER_CLUSTER"
            },
            "metricSelectors": [
              "k8s.pod.network.errors"
            ],
            "type": "metric",
            "valueFormat": "Number",
            "valueLabel": "Network errors",
            "valueType": null
          },
          {
            "coloring": {
              "limits": null,
              "maxValue": 100,
              "method": "quantile",
              "minValue": 0,
              "range": [
                "#6bd37e",
                "#acef7f",
                "#e2ed6a",
                "#eac24b",
                "#ea1849"
              ]
            },
            "description": "This metric shows the amount of CPU used from the assigned CPU limit in percentage. Under 20% (green), over 80% (red).",
            "displayName": "CPU utilization (%)",
            "id": "kubernetes_clusters_cpu_utilization",
            "job": {
              "filters": [
                {
                  "not": false,
                  "property": "k8s.cluster.name",
                  "propertyValue": "*",
                  "type": "property"
                }
              ],
              "resolution": 60000,
              "template": "CPU_UTILIZATION = data(\"container_cpu_utilization\"{{#filter}}, filter={{{filter}}}{{/filter}}, rollup=\"rate\").scale(0.01).sum(by=[\"k8s.cluster.name\"])\nMACHINE_CPU_CORES = data(\"machine_cpu_cores\"{{#filter}}, filter={{{filter}}}{{/filter}}).sum()\nCPU_NUM_PROCESSORS = data(\"cpu.num_processors\"{{#filter}}, filter={{{filter}}}{{/filter}}).sum(by=[\"k8s.cluster.name\"])\nCPU_LIMIT_FARGATE = data(\"k8s.container.cpu_limit\", filter=filter(\"eks.amazonaws.com/fargate-profile\", \"*\"){{#filter}} and {{{filter}}}{{/filter}}).sum(by=[\"k8s.cluster.name\"])\nCPU_UTILIZATION_FARGATE = data(\"container_cpu_utilization\", filter=filter(\"eks.amazonaws.com/fargate-profile\", \"*\"){{#filter}} and {{{filter}}}{{/filter}}, rollup=\"rate\").scale(0.01).sum(by=[\"k8s.cluster.name\"])\nCPU_USED_EKS = (CPU_UTILIZATION/CPU_NUM_PROCESSORS)\nCPU_USED_MACHINE = (CPU_UTILIZATION/MACHINE_CPU_CORES)\nCPU_USED_FARGATE = ((CPU_UTILIZATION_FARGATE*100)/CPU_LIMIT_FARGATE)\nCPU_CAPACITY_USED = union(CPU_USED_EKS, CPU_USED_MACHINE, CPU_USED_FARGATE)",
              "varName": "CPU_CAPACITY_USED"
            },
            "metricSelectors": [
              "container_cpu_utilization",
              "cpu.num_processors",
              "machine_cpu_cores",
              "k8s.container.cpu_limit"
            ],
            "type": "metric",
            "valueFormat": "Percentage",
            "valueLabel": "CPU utilization",
            "valueType": null
          },
          {
            "coloring": {
              "limits": null,
              "maxValue": 100,
              "method": "quantile",
              "minValue": 0,
              "range": [
                "#6bd37e",
                "#acef7f",
                "#e2ed6a",
                "#eac24b",
                "#ea1849"
              ]
            },
            "description": "This metric shows the amount of memory used from the assigned memory limit in percentage. Under 20% (green), over 80% (red).",
            "displayName": "Memory utilization (%)",
            "id": "kubernetes_clusters_memory_utilization",
            "job": {
              "filters": [],
              "resolution": 60000,
              "template": "MEMORY_UTILIZATION = data(\"container.memory.usage\"{{#filter}},filter={{{filter}}}{{/filter}}).sum(by=[\"k8s.cluster.name\"])\nMEMORY_LIMIT = data(\"k8s.container.memory_limit\"{{#filter}}, filter={{{filter}}}{{/filter}}).sum(by=[\"k8s.cluster.name\"])\nMEMORY_CAPACITY=(MEMORY_UTILIZATION/MEMORY_LIMIT)*100",
              "varName": "MEMORY_CAPACITY"
            },
            "metricSelectors": [
              "container.memory.usage",
              "k8s.container.memory_limit"
            ],
            "type": "metric",
            "valueFormat": "Percentage",
            "valueLabel": "Memory utilization",
            "valueType": null
          },
          {
            "coloring": {
              "limits": null,
              "maxValue": null,
              "method": "quantile",
              "minValue": 0,
              "range": [
                "#bfd3e6",
                "#9ebcda",
                "#8c96c6",
                "#8856a7",
                "#810f7c"
              ]
            },
            "description": "This metric shows the current memory usage in bytes. Darker colors indicate higher relative values.",
            "displayName": "Memory usage (bytes)",
            "id": "kubernetes_clusters_memory_usage",
            "job": {
              "filters": [],
              "resolution": 60000,
              "template": "MEMORY_USAGE = data(\"container.memory.usage\"{{#filter}}, filter={{{filter}}}{{/filter}}).sum(by=[\"k8s.cluster.name\"])",
              "varName": "MEMORY_USAGE"
            },
            "metricSelectors": [
              "container.memory.usage"
            ],
            "type": "metric",
            "valueFormat": "ScaleBytes",
            "valueLabel": "Memory usage",
            "valueType": null
          },
          {
            "coloring": {
              "limits": null,
              "maxValue": 100,
              "method": "quantile",
              "minValue": 0,
              "range": [
                "#6bd37e",
                "#acef7f",
                "#e2ed6a",
                "#eac24b",
                "#ea1849"
              ]
            },
            "description": "This metric shows the current file system utilization. Under 20% (green), over 80% (red).",
            "displayName": "File system utilization (%)",
            "id": "kubernetes_clusters_file_system_utilization",
            "job": {
              "filters": [],
              "resolution": 300000,
              "template": "CAPACITY = data('container.filesystem.capacity'{{#filter}}, filter={{{filter}}}{{/filter}}).sum(by=['k8s.cluster.name'])\nUSAGE = data('container.filesystem.usage'{{#filter}}, filter={{{filter}}}{{/filter}}).sum(by=['k8s.cluster.name'])\nFILE_SYSTEM_UTILIZATION= ((USAGE/CAPACITY)*100)",
              "varName": "FILE_SYSTEM_UTILIZATION"
            },
            "metricSelectors": [
              "container.filesystem.capacity",
              "container.filesystem.usage"
            ],
            "type": "metric",
            "valueFormat": "Percentage",
            "valueLabel": "File system utilization",
            "valueType": null
          }
        ],
