            "description": "This metric shows the amount of CPU used from the assigned CPU limit in percentage. Under 20% green, over 80% red.",
            "displayName": "CPU capacity used (%)",
            "id": "k8sclusters_cpu_capacity_used",
            "job": {
              "filters": [],
              "resolution": 60000,
              "template": "CPU_UTILIZATION = data(\"container_cpu_utilization\", filter=filter(\"k8s.cluster.name\", \"*\") and filter(\"k8s.node.name\", \"*\"){{#filter}} and {{{filter}}}{{/filter}}, rollup=\"rate\").scale(0.01).sum(by=[\"k8s.node.name\", \"k8s.cluster.name\"])\nMACHINE_CPU_CORES = data(\"machine_cpu_cores\", filter=filter(\"k8s.cluster.name\", \"*\") and filter(\"k8s.node.name\", \"*\"){{#filter}} and {{{filter}}}{{/filter}}).sum()\nCPU_NUM_PROCESSORS = data(\"cpu.num_processors\", filter=filter(\"k8s.cluster.name\", \"*\") and filter(\"k8s.node.name\", \"*\"){{#filter}} and {{{filter}}}{{/filter}}).sum()\nCPU_LIMIT_FARGATE = data(\"k8s.container.cpu_limit\", filter=filter(\"eks.amazonaws.com/fargate-profile\", \"*\") and filter(\"k8s.cluster.name\", \"*\") and filter(\"k8s.node.name\", \"*\"){{#filter}} and {{{filter}}}{{/filter}}).sum(by=[\"k8s.node.name\", \"k8s.cluster.name\"])\nCPU_UTILIZATION_FARGATE = data(\"container_cpu_utilization\", filter=filter(\"eks.amazonaws.com/fargate-profile\", \"*\") and filter(\"k8s.cluster.name\", \"*\") and filter(\"k8s.node.name\", \"*\"){{#filter}} and {{{filter}}}{{/filter}}, rollup=\"rate\").scale(0.01).sum(by=[\"k8s.node.name\", \"k8s.cluster.name\"])\nCPU_USED_EKS = (CPU_UTILIZATION/CPU_NUM_PROCESSORS)\nCPU_USED_MACHINE = (CPU_UTILIZATION/MACHINE_CPU_CORES)\nCPU_USED_FARGATE = ((CPU_UTILIZATION_FARGATE*100)/CPU_LIMIT_FARGATE)\nCPU_CAPACITY_USED = union(CPU_USED_EKS, CPU_USED_MACHINE, CPU_USED_FARGATE)",
              "varName": "CPU_CAPACITY_USED"
            },
            "metricSelectors": [
              "container_cpu_utilization",
              "cpu.num_processors",
              "machine_cpu_cores",
              "k8s.container.cpu_limit"
            ],
