              "resolution": 60000,
              "template": "MASTER_NODES = data(\"container_cpu_utilization\", filter=(filter(\"kubernetes_role\", \"master\") or filter(\"sf_tags\", \"node-role_kubernetes_io_master\")){{#filter}} and {{{filter}}}{{/filter}}, extrapolation=\"last_value\", maxExtrapolations=2, rollup=\"rate\").scale(0.01).mean(by=[\"k8s.cluster.name\", \"k8s.node.name\"])\nMASTER_NODES.publish(label=\"Master Node\")\nNODE_CONDITION = data(\"k8s.node.condition_*\"{{#filter}}, filter={{{filter}}}{{/filter}}, extrapolation=\"last_value\", maxExtrapolations=2, rollup=\"latest\").sum(by=[\"k8s.cluster.name\", \"k8s.node.name\", \"sf_metric\"])",
