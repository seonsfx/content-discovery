            "id": "Status",
            "job": {
              "filters": [],
              "resolution": 300000,
              "template": "RUNNING = data('k8s.container.restarts', filter=filter('container.status', 'running'){{#filter}} and {{{filter}}}{{/filter}}).sum(by=['k8s.container.name', 'k8s.pod.name', 'k8s.node.name', 'k8s.cluster.name', 'container.id']).promote(by='status', allow_missing={'status':'Running'})\nWAITING = data('k8s.container.restarts', filter=filter('container.status', 'waiting'){{#filter}} and {{{filter}}}{{/filter}}).sum(by=['k8s.container.name', 'k8s.pod.name', 'k8s.node.name', 'k8s.cluster.name', 'container.id']).promote(by='status', allow_missing={'status':'Waiting'})\nTERMINATED = data('k8s.container.restarts', filter=filter('container.status', 'terminated'){{#filter}} and {{{filter}}}{{/filter}}).sum(by=['k8s.container.name', 'k8s.pod.name', 'k8s.node.name', 'k8s.cluster.name', 'container.id']).promote(by='status', allow_missing={'status':'Terminated'})\nNOT_APPLICABLE = data('k8s.container.restarts', filter=(not filter('container.status', '*')){{#filter}} and {{{filter}}}{{/filter}}).sum(by=['k8s.container.name', 'k8s.pod.name', 'k8s.node.name', 'k8s.cluster.name', 'container.id']).promote(by='status', allow_missing={'status':'n/a'})\nPHASE = union(RUNNING,WAITING,TERMINATED,NOT_APPLICABLE)",
              "varName": "PHASE"
            },
