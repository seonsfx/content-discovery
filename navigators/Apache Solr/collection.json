            "id": "solrcollection_cache_hit_ratio",
            "job": {
              "filters": [],
              "resolution": 180000,
              "template": "DOC_CACHE_HIT_RATIO = data(\"gauge.solr.document_cache_cumulative_hitratio\"{{#filter}}, filter={{{filter}}}{{/filter}}, rollup=\"average\").mean(by=[\"collection\"])\nFIELD_CACHE_HIT_RATIO = data(\"gauge.solr.field_value_cache_cumulative_hitratio\"{{#filter}}, filter={{{filter}}}{{/filter}}, rollup=\"average\").mean(by=[\"collection\"])\nQCACHE_HIT_RATIO = data(\"gauge.solr.query_result_cache_cumulative_hitratio\"{{#filter}}, filter={{{filter}}}{{/filter}}, rollup=\"average\").mean(by=[\"collection\"])\nCACHE_HIT_RATIO=(DOC_CACHE_HIT_RATIO + FIELD_CACHE_HIT_RATIO + QCACHE_HIT_RATIO)",
              "varName": "CACHE_HIT_RATIO"
            },
            "metricSelectors": [
              "gauge.solr.document_cache_cumulative_hitratio",
              "gauge.solr.field_value_cache_cumulative_hitratio",
              "gauge.solr.query_result_cache_cumulative_hitratio"
