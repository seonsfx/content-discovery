            "description": "This metric shows the doc growth ratio of last one hour. Darker colors indicate higher relative values.",
            "displayName": "Doc growth",
            "id": "solrcollection_doc_growth",
            "job": {
              "filters": [],
              "resolution": 180000,
              "template": "BEFORE_TIME_SHIFT = data(\"gauge.solr.core_num_docs\"{{#filter}}, filter={{{filter}}}{{/filter}}, rollup=\"average\").mean(by=[\"collection\",\"shard\"]).sum(by=[\"collection\"])\nAFTER_TIME_SHIFT=data(\"gauge.solr.core_num_docs\"{{#filter}}, filter={{{filter}}}{{/filter}}, rollup=\"average\").mean(by=[\"collection\",\"shard\"]).sum(by=[\"collection\"]).timeshift(\"1h\")\nDOC_GROWTH=((BEFORE_TIME_SHIFT -AFTER_TIME_SHIFT)/AFTER_TIME_SHIFT)",
              "varName": "DOC_GROWTH"
            },
            "metricSelectors": [
              "gauge.solr.core_num_docs"
