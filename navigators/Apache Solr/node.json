            "description": "This metric shows the percentage value of total used space available against total space allocated for the core. Darker colors indicate higher relative values.",
            "displayName": "Disk space usage (%)",
            "id": "solrnode_disk_space_usage",
            "job": {
              "filters": [],
              "resolution": 60000,
              "template": "CORE_TOTAL_SPACE = data(\"gauge.solr.core_totalspace\"{{#filter}}, filter={{{filter}}}{{/filter}}, extrapolation=\"last_value\", maxExtrapolations=5)\nCORE_USABLE_SPACE = data(\"gauge.solr.core_usablespace\"{{#filter}}, filter={{{filter}}}{{/filter}}, extrapolation=\"last_value\", maxExtrapolations=5)\nDISK_SPACE_USAGE=((CORE_TOTAL_SPACE-CORE_USABLE_SPACE)*100/CORE_TOTAL_SPACE).mean(by=[\"plugin_instance\"])",
              "varName": "DISK_SPACE_USAGE"
            },
            "metricSelectors": [
