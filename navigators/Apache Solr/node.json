                "#810f7c"
              ]
            },
            "description": "This metric shows the percentage value of JVM garbage collection by CMS process over last minute. This metric is not supported in SOLR version 8.0+. Darker colors indicate higher relative values.",
            "displayName": "GC CMS (%)",
            "id": "solrnode_gc_cms",
            "job": {
              "filters": [],
              "resolution": 60000,
              "template": "GC_CMS_BEFORE = data(\"gauge.solr.jvm_gc_cms_time\"{{#filter}}, filter={{{filter}}}{{/filter}}, extrapolation=\"last_value\", maxExtrapolations=5)\nGC_CMS_AFTER = data(\"gauge.solr.jvm_gc_cms_time\"{{#filter}}, filter={{{filter}}}{{/filter}}, extrapolation=\"last_value\", maxExtrapolations=5).timeshift(\"1m\")\nGC_CMS=((GC_CMS_BEFORE-GC_CMS_AFTER )/60).mean(by=[\"plugin_instance\"])",
              "varName": "GC_CMS"
            },
            "metricSelectors": [
