            "description": "This metric shows the sum of total number of 2xx http responses,4xx http responses and 5xx http responses. Darker colors indicate higher relative values.",
            "displayName": "Responses / Sec",
            "id": "solrnode_response_per_sec",
            "job": {
              "filters": [],
              "resolution": 60000,
              "template": "RESPONSE_VH = data(\"counter.solr.http_5xx_responses\"{{#filter}}, filter={{{filter}}}{{/filter}},rollup=\"rate\", extrapolation=\"last_value\", maxExtrapolations=5).sum(by=\"plugin_instance\")\nRESPONSE_VIH = data(\"counter.solr.http_4xx_responses\"{{#filter}}, filter={{{filter}}}{{/filter}},rollup=\"rate\", extrapolation=\"last_value\", maxExtrapolations=5).sum(by=\"plugin_instance\")\nRESPONSE_IIH = data(\"counter.solr.http_2xx_responses\"{{#filter}}, filter={{{filter}}}{{/filter}},rollup=\"rate\", extrapolation=\"last_value\", maxExtrapolations=5).sum(by=\"plugin_instance\")\nRESPONSE = (RESPONSE_VH + RESPONSE_VIH + RESPONSE_IIH) ",
              "varName": "RESPONSE"
