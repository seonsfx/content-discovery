                        "job": {
                            "filters": [],
                            "resolution": 60000,
                            "template": "MASTER_REPL_OFFSET = data(\"gauge.master_repl_offset\",filter=filter(\"plugin\", \"redis_info\"){{#filter}} and {{{filter}}}{{/filter}}, extrapolation=\"last_value\", maxExtrapolations=5).count(by=[\"plugin_instance\"])\nSLAVE_REPL_OFFSET = data(\"gauge.slave_repl_offset\",filter=filter(\"plugin\", \"redis_info\"){{#filter}} and {{{filter}}}{{/filter}}, extrapolation=\"last_value\", maxExtrapolations=5).count(by=[\"plugin_instance\"])\nTOTAL_OFFSET = (SLAVE_REPL_OFFSET+MASTER_REPL_OFFSET)\nLEADER = union(TOTAL_OFFSET ,MASTER_REPL_OFFSET).max(by=[\"plugin_instance\"]).between(0.5, 1.5, clamp=False)",
