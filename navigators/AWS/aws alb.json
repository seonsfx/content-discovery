            "description": "This metric shows the percentage of targets of the load balancer that are considered unhealthy. Below 20% green and over 80% red.",
            "displayName": "Unhealthy hosts (%)",
            "id": "awsalbinstances_unhealthy_hosts",
            "job": {
              "filters": [],
              "resolution": 60000,
              "template": "HEALTHY = data(\"HealthyHostCount\", filter=filter(\"namespace\",\"AWS/ApplicationELB\") and filter(\"stat\",\"mean\") and filter(\"AvailabilityZone\", \"*\") and filter(\"TargetGroup\", \"*\"){{#filter}} and {{{filter}}}{{/filter}}, extrapolation=\"last_value\", maxExtrapolations=2).sum(by=[\"LoadBalancer\"])\nUNHEALTHY = data(\"UnHealthyHostCount\", filter=filter(\"namespace\",\"AWS/ApplicationELB\") and filter(\"stat\",\"mean\") and filter(\"AvailabilityZone\", \"*\") and filter(\"TargetGroup\", \"*\"){{#filter}} and {{{filter}}}{{/filter}}, extrapolation=\"last_value\", maxExtrapolations=2).sum(by=[\"LoadBalancer\"])\nPERCENTAGE =(UNHEALTHY/(HEALTHY +UNHEALTHY)).scale(100)",
              "varName": "PERCENTAGE"
            },
            "metricSelectors": [
              "HealthyHostCount",
              "UnHealthyHostCount"
            ],
            "type": "metric",
            "valueFormat": "Percentage",
            "valueLabel": "Unhealthy hosts",
            "valueType": null
