                  "propertyValue": "cluster",
                  "type": "property"
                }
              ],
              "resolution": 60000,
              "template": "GC_TIME=data(\"*.jvm.gc.time\",filter=filter(\"plugin\", \"elasticsearch\") and ( not filter(\"aggregation\",'*', match_missing=True)) {{#filter}} and {{{filter}}}{{/filter}}, rollup='max',extrapolation=\"last_value\", maxExtrapolations=2).mean(by=[\"host\"])\nGC_UPTIME=data(\"*.jvm.uptime\",filter=filter(\"plugin\", \"elasticsearch\") and ( not filter(\"aggregation\",'*', match_missing=True)) {{#filter}} and {{{filter}}}{{/filter}}, rollup='max',extrapolation=\"last_value\", maxExtrapolations=2).mean(by=[\"host\"])\nGC_TIME_LAST_HOUR = (GC_TIME).timeshift(\"1h\")\nGC_UPTIME_LAST_HOUR = (GC_UPTIME).timeshift(\"1h\")\nGC_TIME_PCT = ((GC_TIME-GC_TIME_LAST_HOUR)/(GC_UPTIME-GC_UPTIME_LAST_HOUR)*100)",
              "varName": "GC_TIME_PCT"
            },
