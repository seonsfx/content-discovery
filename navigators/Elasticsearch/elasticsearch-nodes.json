            "job": {
              "filters": [],
              "resolution": 60000,
              "template": "INDEX_DELETED = data(\"*.indices.docs.deleted\",filter=filter(\"plugin\", \"elasticsearch\") and ( not filter(\"aggregation\",' * OR aggregation: total', match_missing=True)) {{#filter}} and {{{filter}}}{{/filter}}, rollup=\"rate\",extrapolation=\"last_value\", maxExtrapolations=2).mean(by=[\"host\"])\nINDEX_COUNT = data(\"*.indices.docs.count\",filter=filter(\"plugin\", \"elasticsearch\") and ( not filter(\"aggregation\",' * OR aggregation: total', match_missing=True)) {{#filter}} and {{{filter}}}{{/filter}}, rollup=\"rate\",extrapolation=\"last_value\", maxExtrapolations=2).mean(by=[\"host\"])\nINDEX_DELETED_PCT = (INDEX_DELETED*100/INDEX_COUNT).mean(by=[\"host\"])",
