              "template": "TOTAL_REQ_PROCESS_TIME = data(\"apache.request.time\"{{#filter}}, filter={{{filter}}}{{/filter}}, rollup='latest').sum(by=['host.name'])\nREQ_SERVED = data(\"apache.requests\"{{#filter}}, filter={{{filter}}}{{/filter}}, rollup='latest').sum(by=['host.name'])\nREQ_PROCESS_TIME = (TOTAL_REQ_PROCESS_TIME/REQ_SERVED)",
