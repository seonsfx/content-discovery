        "lastUpdated": 0,
        "lastUpdatedBy": null,
        "name": "Drops explainer",
        "options": {
          "markdown": "If the volume of data received is higher than the volume accepted, check these charts for the reason. Log messages can be rejected for being malformed, being too large or having invalid timestamps. When the volume of incoming data is higher than the system capacity available to receive it, log messages are throttled as a last resort. In the graphs to the right, you can see the number of log messages not accepted, the reason, and the token that sent them.",
          "type": "Text"
        },
        "packageSpecifications": "",
        "programText": "",
        "relatedDetectorIds": [],
        "tags": null
      }
