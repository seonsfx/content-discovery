receivers:
  prometheus_simple/oracle_exporter:
    endpoint: "localhost:9161"

processors:
  resourcedetection:
    detectors: [gce, ecs, ec2, azure, system, env]
    override: true
  resource/add_environment:
    attributes:
      action: insert
      value: BITS_Database_Related_Content
      key: deployment.environment
exporters:
  logging:
    logLevel: debug
  signalfx:
    access_token: "${SPLUNK_ACCESS_TOKEN}"
    api_url: "${SPLUNK_API_URL}"
    ingest_url: "${SPLUNK_INGEST_URL}"
    sync_host_metadata: true
    correlation:
  signalfx/lab:
    access_token: CJ3NkOwgx7Tqh2HDxjFQhQ
    api_url: "https://external-api.lab0.signalfx.com"
    ingest_url: "https://external-ingest.lab0.signalfx.com"
    sync_host_metadata: true
    correlation:

service:
  pipelines:
    metrics:
      receivers: [prometheus_simple/oracle_exporter]
      processors: [resourcedetection, resource/add_environment]
      exporters: [signalfx/lab]