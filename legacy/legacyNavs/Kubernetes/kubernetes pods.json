                "#8856a7",
                "#810f7c"
              ]
            },
            "description": "Container memory usage in bytes, summed per pod. This uses the container_memory_usage_bytes metric.",
            "displayName": "Pod Memory Usage",
            "id": "container_memory_usage_bytes",
            "job": {
              "filters": [
                {
